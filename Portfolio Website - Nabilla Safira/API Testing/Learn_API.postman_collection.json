        {
          "name": "Detail Post id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();\r",
                  "// const = membuat variabel yang nilainya tidak bisa diubah\r",
                  "// data = nama variabel (bebas, bisa diganti misalnya responseData)\r",
                  "// pm.response.json() = mengambil body response API lalu mengubahnya menjadi format JSON (object/array JavaScript)\r",
                  "\r",
                  "pm.test('Detail Post id is object{}',()=>{ \r",
                  "    pm.expect(data).to.be.an('object'); // Menampilkan albums berisi object (yang menggunakan kurung kurawal {})\r",
                  "})\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 200ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
