    {
      "name": "GET",
      "item": [
        {
          "name": "Get List Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// {} = Object -> akses dengan titik (.)\r",
                  "// [] = Array -> akses dengan indeks ([0], [1], [2], ...)\r",
                  "// Indeks array dimulai dari 0\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json(); // Mengubah response API menjadi object/array JavaScript\r",
                  "\r",
                  "console.log('>> data', data[1]);      // [] = Array, [1] mengambil item ke-2\r",
                  "console.log('>> total', data.length); // length = menghitung jumlah item dalam array\r",
                  "\r",
                  "// * Filter tidak ditemukan\r",
                  "pm.test('Filter: Not Found', () => {\r",
                  "    pm.expect(data.length).to.eql(0); // Diharapkan tidak ada data\r",
                  "});\r",
                  "\r",
                  "// * Filter menghasilkan 1 data\r",
                  "pm.test('Filter: 1 item', () => {\r",
                  "    pm.expect(data.length).to.eql(1); // Diharapkan hanya ada 1 data\r",
                  "});\r",
                  "\r",
                  "// * Filter menghasilkan lebih dari 1 data\r",
                  "pm.test('Filter: Multiple Item', () => {\r",
                  "    pm.expect(data.length).to.be.greaterThan(1); // Diharapkan lebih dari 1 data\r",
                  "});\r",
                  "\r",
                  "pm.test('List users has required id,username,email',()=>{\r",
                  "    const listusers = data[0]\r",
                  "\r",
                  "    // pm.expect(listusers).to.have.property('id').to.be.a('number')\r",
                  "    // pm.expect(listusers).to.have.property('username').to.be.a('string').not.be.empty\r",
                  "    // pm.expect(listusers).to.have.property('email').to.be.a('string').not.be.empty\r",
                  "\r",
                  "    pm.expect(listusers.id).to.be.a('number')\r",
                  "    pm.expect(listusers.username).to.be.a('string').and.not.be.empty\r",
                  "    pm.expect(listusers.email).to.be.a('string').and.not.be.empty\r",
                  "\r",
                  " //id : \"1\" number\r",
                  " //username : \"Bret\" string\r",
                  " //email : \"Sincere@april.biz\" string\r",
                  "\r",
                  "})\r",
                  "\r",
                  "// * Ubah indeks array ([0], [1], dst.) atau nilai length sesuai skenario testing\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BaseURL}}/users",
              "host": [
                "{{BaseURL}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "Antonette",
                  "disabled": true
                },
                {
                  "key": "username",
                  "value": "Bret",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get List Albums",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ==============================\r",
                  "// CEK STATUS CODE\r",
                  "// ==============================\r",
                  "\r",
                  "// Membuat test\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "\r",
                  "    // Memastikan status response = 200 (Success)\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// ==============================\r",
                  "// CEK ISI RESPONSE\r",
                  "// ==============================\r",
                  "\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "\r",
                  "    // Mengecek apakah response mengandung nilai \"1\"\r",
                  "    pm.expect(pm.response.text()).to.include(\"1\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// ==============================\r",
                  "// FILTER DATA BERDASARKAN JUMLAH ITEM\r",
                  "// data.length = jumlah data dalam array\r",
                  "// ==============================\r",
                  "\r",
                  "if (data.length === 0){\r",
                  "\r",
                  "    // Jika data kosong\r",
                  "    pm.test(\"Filter: Not Found\", () => {\r",
                  "        pm.expect(data.length).to.eql(0);\r",
                  "    });\r",
                  "\r",
                  "} else if (data.length === 1){\r",
                  "\r",
                  "    // Jika hanya ada 1 data\r",
                  "    pm.test(\"Filter: 1 Item\", () => {\r",
                  "        pm.expect(data.length).to.eql(1);\r",
                  "    });\r",
                  "\r",
                  "} else if (data.length > 1){\r",
                  "\r",
                  "    // Jika data lebih dari 1\r",
                  "    pm.test(\"Filter: Multiple Item\", () => {\r",
                  "        pm.expect(data.length).to.be.greaterThan(1);\r",
                  "    });\r",
                  "\r",
                  "} else {\r",
                  "\r",
                  "    // Menampilkan pesan ke Postman Console (debugging)\r",
                  "    console.log(\"not handle..\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "// ==============================\r",
                  "// CATATAN SINGKAT\r",
                  "// ==============================\r",
                  "\r",
                  "// pm.test()              -> Membuat test\r",
                  "// pm.expect()            -> Melakukan validasi (assertion)\r",
                  "// pm.response            -> Mengambil response API\r",
                  "// pm.response.text()     -> Mengambil body response dalam bentuk text\r",
                  "// .to.have.status(200)   -> Cek status code\r",
                  "// .to.include()          -> Cek apakah ada nilai tertentu\r",
                  "// .to.eql()              -> Nilai harus sama persis\r",
                  "// .greaterThan()         -> Nilai harus lebih besar\r",
                  "// data.length            -> Menghitung jumlah data dalam array\r",
                  "// console.log()          -> Menampilkan pesan di Postman Console"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BaseURL}}/albums",
              "host": [
                "{{BaseURL}}"
              ],
              "path": [
